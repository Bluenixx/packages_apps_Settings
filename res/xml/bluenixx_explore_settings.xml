<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="Bluenixx Explore">

    <Preference
        android:key="bluenixx_explore_lock_screen"
        android:icon="@drawable/ic_bluenixx_lock_screen"
        android:title="Tela de bloqueio"
        android:summary="Ícone da impressão digital"
        android:fragment="com.android.settings.bluenixx.BluenixxExploreLockScreenSettings" />

    <Preference
        android:key="bluenixx_explore_display"
        android:icon="@drawable/ic_bluenixx_display"
        android:title="Tela"
        android:summary="Dynamic Bar e opções de exibição"
        android:fragment="com.android.settings.bluenixx.BluenixxExploreDisplaySettings" />

    <Preference
        android:key="bluenixx_explore_quick_settings"
        android:title="Quick Settings"
        android:summary="Escolha o estilo do painel de configurações rápidas"
        android:fragment="com.android.settings.bluenixx.BluenixxExploreQuickSettings" />

</PreferenceScreen>
